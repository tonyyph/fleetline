# Copy to .env and fill in from Supabase Dashboard → Project Settings → API (or the "Connect" dialog).
# Only the client-safe key goes here. NEVER put the service_role / secret key in the app:
# every EXPO_PUBLIC_* value is bundled into the binary.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Older projects: use the "anon" key instead (either variable works).
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
